# Copy to .env and set both values to unique random credentials.
# The Compose file refuses to start while either value is empty.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=objects
S3_REGION=us-east-1
S3_CREDENTIALS_FILE=
S3_KEY_SCOPES_FILE=
METRICS_BEARER_TOKEN=
HOST_PORT=9000
MAX_OBJECT_BYTES=134217728
MAX_TOTAL_BYTES=2147483648
PUBLIC_REQUESTS_PER_SECOND=0
PUBLIC_REQUEST_BURST=
PUBLIC_BYTES_PER_SECOND=0
PUBLIC_BYTE_BURST=
PUBLIC_MAX_IN_FLIGHT_PER_IP=
PUBLIC_TRUSTED_PROXY_IPS=
MAX_IN_FLIGHT_REQUESTS=16
HTTP_BACKLOG=64
S3_VIRTUAL_HOST_SUFFIX=
CORS_ALLOWED_ORIGINS=
OBJECTSTORE_REQUEST_TIMEOUT_SECONDS=0
OBJECTSTORE_RESPONSE_TIMEOUT_SECONDS=0
# For compose.encrypted.yaml only; provision and mount LUKS before setting these.
ENCRYPTED_STORAGE_ROOT=
ENCRYPTED_VOLUME_ID=
